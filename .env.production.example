# 生产环境变量模板（TASK-020）
# 用法：
#   cp .env.production.example .env.production
#   填写全部空白项（密钥生成：openssl rand -hex 48）
#   bash scripts/preflight-prod.sh --env-file .env.production   # 上线前体检
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# ===== 入口端口 =====
HTTP_PORT=80
HTTPS_PORT=443

# ===== 数据库（容器内网） =====
MYSQL_DATABASE=growthkids
MYSQL_USER=growthkids
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ===== Redis =====
REDIS_PASSWORD=

# ===== 密钥（生产必须为强随机值；缺失则 API 启动失败） =====
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
STORAGE_SIGNING_SECRET=
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_SIGNING_SECRET=

# ===== 站点与 CORS =====
# 前端构建期注入的 API 地址：必须完整且与站点同域（构建后不可变）
NEXT_PUBLIC_API_URL=https://growthkids.example.com
WEB_ORIGIN=https://growthkids.example.com
NGINX_ORIGIN=https://growthkids.example.com

# ===== WHO 生长标准（生产必填） =====
# 先把官方 CSV 放到宿主 data/who-official/，容器内只读挂载为 /data/who。
# 留空则回退镜像内置合成示例（source=growthkids-example-synthetic，仅联调可用）；
# 路径写错或文件不合法会阻止 API 启动（有意 fail-fast）。格式见 data/who/README.md
APP_WHO_DATA_FILE=file:/data/who/who-standards-official.csv

# ===== 首个管理员（§77；留空则不创建） =====
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ===== 备份（§117：每日一次，保留 30 天） =====
BACKUP_RETENTION_DAYS=30
