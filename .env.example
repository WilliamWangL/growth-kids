# ===== 通用 =====
NODE_ENV=development
SPRING_PROFILES_ACTIVE=dev

# ===== 数据库（MySQL 8） =====
MYSQL_HOST=localhost
MYSQL_PORT=3310
MYSQL_DATABASE=growthkids
MYSQL_USER=growthkids
MYSQL_PASSWORD=growthkids
MYSQL_ROOT_PASSWORD=growthkids-root

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6385
REDIS_PASSWORD=

# ===== Auth（生产必须替换为强随机值） =====
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ===== API / Web =====
API_PORT=8082
NEXT_PUBLIC_API_URL=http://localhost:8082

# ===== 照片本地存储（v1） =====
STORAGE_LOCAL_PATH=./storage
# 签名 URL 密钥（生产必须替换为强随机值）
STORAGE_SIGNING_SECRET=
# 签名 URL 有效期（秒）
STORAGE_URL_EXPIRY=600
STORAGE_ACCEL_REDIRECT=false

# ===== Nginx（本机默认 8090，避免与其他项目冲突） =====
NGINX_HTTP_PORT=8090

# ===== 支付（TASK-017，未配置时使用 MockPaymentProvider） =====
PAYMENT_PROVIDER=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ===== AI（可选，默认关闭） =====
AI_PROVIDER=
AI_API_KEY=

# ===== Seed（仅开发环境） =====
ENABLE_DEMO_SEED=true
